<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:allowBackup="true"
        android:label="Calendario"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.Dialog.Alert" />
        <receiver
            android:name=".MonthCalendarWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/month_widget_info" />
        </receiver>
        <receiver
            android:name=".AgendaWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/agenda_widget_info" />
        </receiver>
        <receiver
            android:name=".BirthdayWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/birthday_widget_info" />
        </receiver>
    </application>
</manifest>
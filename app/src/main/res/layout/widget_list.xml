<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_list_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Próximos eventos"
            android:textColor="#29304A"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_configure"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#29304A"
            android:contentDescription="Configurar transparencia" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_list_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tu agenda"
        android:textColor="#777B8B"
        android:textSize="11sp"
        android:paddingBottom="6dp" />
    <LinearLayout
        android:id="@+id/widget_list_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />
    <LinearLayout
        android:id="@+id/widget_action_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingTop="6dp">
        <TextView android:id="@+id/widget_add_event" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="+ Evento" android:textColor="#29304A" android:textStyle="bold" android:background="#5263A8" />
        <TextView android:id="@+id/widget_add_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:padding="8dp" android:text="+ Día" android:textColor="#29304A" android:textStyle="bold" android:background="#665A8E" />
        <TextView android:id="@+id/widget_add_reminder" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:padding="8dp" android:text="⏰" android:contentDescription="Añadir recordatorio" android:textColor="#29304A" android:background="#9B5474" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_list_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#777B8B"
        android:textSize="12sp"
        android:visibility="gone"
        android:paddingTop="8dp" />
</LinearLayout>